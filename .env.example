# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=zKXHe-Ahdb7aPK1ylAJlRgTefktEaACi
APP_URL=http://${HOST}:${PORT}

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=adonis

# Session
SESSION_DRIVER=cookie

# JWT (base64-encoded RSA keys — generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | tee private.pem && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
MAIL_MAILER=log
MAIL_FROM_NAME=BAE
MAIL_FROM_ADDRESS=no-reply@bae.eirb.fr

# Adresse publique de l'IdP (celle du navigateur, et du claim `iss`).
KEYCLOAK_ISSUER=http://localhost:8080/realms/bae
# Chemin serveur -> IdP quand il diffère du public (API en conteneur,
# réseau interne). Vide si les deux adresses coïncident.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_CLIENT_ID=bae-back
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=http://localhost:3333/v1/auth/keycloak/callback
KEYCLOAK_ALLOW_INSECURE=true
DASHBOARD_URL=http://localhost:4200
PUBLIC_APP_URL=http://localhost:4201

# Domaine du cookie de session. Laisser vide en local : le cookie est alors
# host-only, ce qui convient sur localhost. En production : .bae.eirb.fr
COOKIE_DOMAIN=

# Remise de précommande, en % du tarif public. Ligne absente = 10 %.
PRE_ORDER_DISCOUNT_PERCENT=10

# Réduction supplémentaire des adhérents sur les précommandes, en %. Ligne absente = 5 %.
FAST_PASS_PRE_ORDER_BONUS_PERCENT=5

# Heures avant le début d'une soirée où les précommandes ferment. Ligne absente = 12.
PRE_ORDER_CLOSE_LEAD_HOURS=12

# Paiement — Lydia
# `fake` partout sauf en production : les jetons du BAE sont
  ceux de production.
LYDIA_DRIVER=fake
LYDIA_URL=https://lydia-app.com
LYDIA_VENDOR_TOKEN=
LYDIA_PRIVATE_TOKEN=
# Adresse publique joignable par Lydia. En local, un
  tunnel.
LYDIA_CALLBACK_BASE_URL=http://localhost:3333
